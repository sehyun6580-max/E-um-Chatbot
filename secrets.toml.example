# 이 내용을 Streamlit Community Cloud → 앱 Settings → Secrets 칸에 붙여넣고 실제 값으로 바꾸세요.
# (로컬에서 돌릴 때는 .streamlit/secrets.toml 로 저장. 이 파일은 GitHub에 올라가지 않습니다)

ANTHROPIC_API_KEY = "PASTE_YOUR_ANTHROPIC_KEY"
OPENAI_API_KEY = "PASTE_YOUR_OPENAI_KEY"

# 선택: 입장 비밀번호. 지우면 링크를 아는 누구나 바로 사용할 수 있어요.
APP_PASSWORD = "PASTE_A_PASSWORD_TO_SHARE"

# 선택: 모델 바꾸기
# ANTHROPIC_MODEL = "claude-sonnet-5-5"
# OPENAI_MODEL = "gpt-5.6-sol"
